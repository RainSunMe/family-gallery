# ---------------------------------------------------------------------------
# Production-oriented defaults. Copy to .env and replace every placeholder.
# Every value below is a real configuration option of the application.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=production
APP_ADDR=:8080
APP_PUBLIC_URL=https://photos.example.com
DATABASE_PATH=/app/data/gallery.db

# Branding shown in the UI (optional, safe to customise)
SITE_NAME=Family Gallery
SITE_TAGLINE=PRIVATE FAMILY PHOTOS
SITE_DESCRIPTION=A self-hosted family photo album

# Default UI language for visitors without a preference: en | zh
DEFAULT_LANGUAGE=en

# Credentials (required, no defaults)
FAMILY_PASSWORD=REPLACE_WITH_LONG_FAMILY_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_ADMIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# S3-compatible storage (Garage, MinIO, SeaweedFS, AWS S3, ...)
S3_ENDPOINT=https://s3.internal.example.com
S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_REGION=garage
S3_BUCKET=family-gallery
S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
S3_USE_PATH_STYLE=true

# Sessions and signed URLs
FAMILY_SESSION_TTL=720h
ADMIN_SESSION_TTL=12h
SIGNED_READ_TTL=5m
SIGNED_UPLOAD_TTL=15m
COLLECTION_SESSION_TTL=168h

# Upload and download limits
MAX_UPLOAD_SIZE=209715200
MULTIPART_PART_SIZE=8388608
DOWNLOAD_PART_SIZE=524288000
DOWNLOAD_RETENTION=24h
WORKER_INTERVAL=2s

# Duplicate detection. The browser hashes each file (SHA-256) and the server
# refuses a second copy of the same bytes in the same album, unless the user
# chooses to add it anyway.
DEDUP_ENABLED=true
# Hash photos uploaded before dedup existed. Off by default: it reads every
# original back out of the bucket once.
DEDUP_BACKFILL=false

# Deleted photos stay in the trash for this long before the worker removes them
# for good. Use 0 to keep them until an admin empties the trash.
TRASH_RETENTION=720h

# Login throttling
LOGIN_MAX_ATTEMPTS=10
LOGIN_BLOCK_DURATION=5m
